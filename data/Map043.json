{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":108,"indent":0,"parameters":["↓日付経過演出"]},{"code":261,"indent":0,"parameters":["count/night4-5"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Vale, vamos a hacer que descansen en paz.\\!"]},{"code":401,"indent":0,"parameters":["Prepara tu alma y tu fé, empezamos mañana."]},{"code":230,"indent":0,"parameters":[60]},{"code":108,"indent":0,"parameters":["↓日付経過演出　逆行"]},{"code":261,"indent":0,"parameters":["count/night5-4"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Bueno, llegó el primer día. \\!"]},{"code":401,"indent":0,"parameters":["Mis explicaciones sólo son la base, no sé cómo te atacarán sus espíritus."]},{"code":401,"indent":0,"parameters":["Sólo sé que si te atrapan... Será tu perdición.\\!"]},{"code":401,"indent":0,"parameters":["Espero que mañana podamos volver a hablar.\\!"]},{"code":230,"indent":0,"parameters":[60]},{"code":108,"indent":0,"parameters":["↓日付経過演出"]},{"code":261,"indent":0,"parameters":["count/night4-3"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Vale, parece que la situación no ha cambiado desde ayer."]},{"code":401,"indent":0,"parameters":["Así que hoy me aseguraré de que puedas hablar con todas, salvo Fina.\\!"]},{"code":401,"indent":0,"parameters":["Ya sé que la idea de un exorcismo es ridícula..."]},{"code":401,"indent":0,"parameters":["Pero tú eres la clave. Venga, no te rindas. Esto acaba de empezar."]},{"code":230,"indent":0,"parameters":[60]},{"code":108,"indent":0,"parameters":["↓日付経過演出"]},{"code":261,"indent":0,"parameters":["count/night3-2"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Hoy haré lo mismo que ayer, evitar que Fina hable contigo. \\!"]},{"code":401,"indent":0,"parameters":["El resto... Bueno, no sé si el resto serán tan amables como Melania."]},{"code":401,"indent":0,"parameters":["Ten cuidado, a ver si podemos salvar a las otras tres."]},{"code":230,"indent":0,"parameters":[60]},{"code":108,"indent":0,"parameters":["↓日付経過演出"]},{"code":261,"indent":0,"parameters":["count/night2-1"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Nos quedan dos.\\!"]},{"code":401,"indent":0,"parameters":["Menos espectros implica menos ataques, pero no se confíe."]},{"code":401,"indent":0,"parameters":["La consecuencia de que te atrapen sigue siendo la misma.\\!"]},{"code":401,"indent":0,"parameters":["Sí, yo también haré todo lo que esté en mi mano."]},{"code":230,"indent":0,"parameters":[60]},{"code":108,"indent":0,"parameters":["↓日付経過演出"]},{"code":261,"indent":0,"parameters":["count/night1-0"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,"¿?"]},{"code":401,"indent":0,"parameters":["Hoy es el último día.\\!"]},{"code":401,"indent":0,"parameters":["Y sí, haremos lo mismo que los otros días.\\!"]},{"code":401,"indent":0,"parameters":["Tenemos que hacer que descansen en paz..."]},{"code":401,"indent":0,"parameters":["Fuera de esta pesadilla... Y así absolverte de tu pecado."]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,2,1,""]},{"code":401,"indent":0,"parameters":["\\C[18]Blande el ratón para empezar."]},{"code":222,"indent":0,"parameters":[]},{"code":357,"indent":0,"parameters"