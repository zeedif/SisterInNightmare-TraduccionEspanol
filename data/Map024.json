ro nada, incluso empecé a dudar de su existencia."]},{"code":401,"indent":1,"parameters":["¿Tú qué opinas del tema?"]},{"code":101,"indent":1,"parameters":["",0,0,2,"¿?¿?"]},{"code":401,"indent":1,"parameters":["Ya veo... ¿Y qué piensas de lo otro?"]},{"code":401,"indent":1,"parameters":["Es que he escuchado que ya están a punto de terminar las reparaciones."]},{"code":401,"indent":1,"parameters":["A, vale, ya veo. Bueno, te diría que sería un buen momento para unirnos,"]},{"code":401,"indent":1,"parameters":["aunque algo así... Es más fácil decirlo que hacerlo."]},{"code":230,"indent":1,"parameters":[60]},{"code":101,"indent":1,"parameters":["",0,0,2,"¿?¿?"]},{"code":401,"indent":1,"parameters":["O, ¿ya está? Tú tan ocupado como siempre.\\!"]},{"code":401,"indent":1,"parameters":["Vale, no te preocupas, ya me las aviaré para volver a contactarte."]},{"code":101,"indent":1,"parameters":["",0,0,2,"¿?¿?"]},{"code":401,"indent":1,"parameters":["Vale, hasta la próxima."]},{"code":230,"indent":1,"parameters":[30]},{"code":250,"indent":1,"parameters":[{"name":"電話３","volume":90,"pitch":100,"pan":0}]},{"code":230,"indent":1,"parameters":[60]},{"code":230,"indent":1,"parameters":[60]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":102,"indent":0,"parameters":[["Volver a la portada"],0,-1,2,0]},{"code":402,"indent":0,"parameters":[0,"Volver a la portada"]},{"code":354,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":139,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableV